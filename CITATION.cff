# This repository uses file-based split licensing; LICENSE.md is authoritative.
# CFF 1.2 interprets multiple `license` values as alternatives (OR), so it cannot
# faithfully encode the path-scoped Apache-2.0 / CC-BY-4.0 split. The root
# `license` and `license-url` fields are therefore deliberately omitted.
references:
