    # The pinned commit below is the v0.2.1 release commit, so the release can be named
    # here too. `version` / `date-released` describe the upstream release; `commit` stays
    # authoritative for what was extracted. Only set `version` while the pin sits exactly
    # on a release tag — drop it again on any repin to an untagged commit, rather than
    # letting it claim a release the extraction did not come from.
    version: "0.2.1"
