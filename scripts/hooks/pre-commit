#!/usr/bin/env bash
# pre-commit hook for leray-hopf-notes
#
# Runs lightweight corpus checks (no Lean build required).
# Activate with: git config core.hooksPath scripts/hooks
#
# Checks:
#   1. validate.py     — YAML schema + corpus ⊆ universe
#   2. glossary_lint.py — forbidden translation detection
#   3. prose_lint.py --strict — D1/D2/D5 prose typography (notes#12). --strict so the
#      local gate matches CI (notes#124); soft warnings gate here too, otherwise a commit
#      that passes the hook can still fail CI.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

PYTHON="${PYTHON:-python3}"

echo "==> leray-hopf-notes pre-commit: validate corpus..."
"$PYTHON" scripts/validate.py
echo ""

echo "==> leray-hopf-notes pre-commit: glossary lint..."
"$PYTHON" scripts/glossary_lint.py
echo ""

echo "==> leray-hopf-notes pre-commit: prose lint (D1/D2/D5, strict)..."
"$PYTHON" scripts/prose_lint.py --strict
echo ""

echo "==> pre-commit checks passed."
